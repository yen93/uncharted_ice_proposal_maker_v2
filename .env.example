# Google Cloud OAuth client (Drive + Slides scopes enabled)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Populated by oauth_setup.py after completing the consent flow once.
# v2 only needs Drive + Slides scopes; a token minted for v1 (which also has
# Gmail/Forms) works fine here since its scopes are a superset.
GOOGLE_REFRESH_TOKEN=
