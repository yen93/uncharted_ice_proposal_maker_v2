# Google Cloud OAuth client (Drive + Slides + Gmail scopes enabled)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Populated by oauth_setup.py after completing the consent flow once.
# The interactive skill needs drive + presentations + gmail.send. A token minted
# for v1 (which also has Gmail/Forms) works fine here since its scopes are a superset.
GOOGLE_REFRESH_TOKEN=

# --- Supabase: the proposal_demo_notes_email_logs queue the cloud routine drains. ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
